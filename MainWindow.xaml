<Window x:Class="LyricPin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricPin"
        Width="300"
        Height="190"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="LyricsViewport"
                      Grid.Row="0"
                      Width="300"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      ClipToBounds="True"
                      HorizontalContentAlignment="Left"
                      Focusable="False">
        <Grid x:Name="LyricsContent">
            <StackPanel x:Name="OutgoingLyricLinesPanel"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="OutgoingLyricLinesTranslateTransform" />
                </StackPanel.RenderTransform>
                <TextBlock x:Name="OutgoingPreviousLyricText"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="14.4"
                           Foreground="White"
                           Opacity="0.58"
                           TextAlignment="Center" />
                <TextBlock x:Name="OutgoingCurrentLyricText"
                           Margin="0,2"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center" />
                <TextBlock x:Name="OutgoingNextLyricText"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="14.4"
                           Foreground="White"
                           Opacity="0.58"
                           TextAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="LyricLinesPanel"
                        HorizontalAlignment="Center">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="LyricLinesTranslateTransform" />
            </StackPanel.RenderTransform>
            <TextBlock x:Name="PreviousLyricText"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="14.4"
                       Foreground="White"
                       Opacity="0.58"
                       RenderTransformOrigin="0.5,0.5"
                       TextAlignment="Center">
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PreviousLyricScaleTransform" />
                        <TranslateTransform x:Name="PreviousLyricTranslateTransform" />
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>
            <Grid x:Name="CurrentLyricRow"
                  Margin="0,2"
                  HorizontalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CurrentLyricScaleTransform" />
                        <TranslateTransform x:Name="CurrentLyricTranslateTransform" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <TextBlock x:Name="CurrentLyricBaseText"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#78FFFFFF"
                           Text="正在连接网易云音乐…"
                           TextAlignment="Center" />
                <TextBlock x:Name="CurrentLyricText"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="正在连接网易云音乐…"
                           TextAlignment="Center">
                    <TextBlock.Clip>
                        <RectangleGeometry x:Name="CurrentLyricClip" />
                    </TextBlock.Clip>
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="5"
                                          Direction="270"
                                          Opacity="0.85"
                                          ShadowDepth="2"
                                          Color="#CC000000" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
            <TextBlock x:Name="NextLyricText"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="14.4"
                       Foreground="White"
                       Opacity="0.58"
                       RenderTransformOrigin="0.5,0.5"
                       TextAlignment="Center">
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="NextLyricScaleTransform" />
                        <TranslateTransform x:Name="NextLyricTranslateTransform" />
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>
            </StackPanel>
        </Grid>
        </ScrollViewer>
        <Grid x:Name="WidthIndicatorPanel"
              Grid.Row="1"
              Height="8"
              Margin="0,0,0,4"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="WidthIndicatorTranslateTransform" />
            </Grid.RenderTransform>
            <Grid x:Name="WidthIndicatorTrack"
                  Height="3"
                  VerticalAlignment="Center"
                  Background="#FF42A5F5" />
        </Grid>
    </Grid>
</Window>
