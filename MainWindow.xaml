<Window x:Class="LyricPin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricPin"
        Width="300"
        Height="190"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="PlaybackControlButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#32FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#526C8CFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseEnter="RootGrid_MouseEnter"
          MouseLeave="RootGrid_MouseLeave">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="LyricBackdrop"
                Grid.RowSpan="2"
                Margin="2"
                Background="#33171A21"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="16"
                IsHitTestVisible="False"
                Opacity="0" />
        <ScrollViewer x:Name="LyricsViewport"
                      Grid.Row="0"
                      Width="300"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      ClipToBounds="True"
                      HorizontalContentAlignment="Left"
                      Focusable="False">
        <Grid x:Name="LyricsContent">
            <StackPanel x:Name="OutgoingLyricLinesPanel"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="OutgoingLyricLinesTranslateTransform" />
                </StackPanel.RenderTransform>
                <TextBlock x:Name="OutgoingPreviousLyricText"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="14.4"
                           Foreground="White"
                           Opacity="0.58"
                           TextAlignment="Center" />
                <TextBlock x:Name="OutgoingCurrentLyricText"
                           Margin="0,2"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center" />
                <TextBlock x:Name="OutgoingNextLyricText"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="14.4"
                           Foreground="White"
                           Opacity="0.58"
                           TextAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="LyricLinesPanel"
                        HorizontalAlignment="Center">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="LyricLinesTranslateTransform" />
            </StackPanel.RenderTransform>
            <TextBlock x:Name="PreviousLyricText"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="14.4"
                       Foreground="White"
                       Opacity="0.58"
                       RenderTransformOrigin="0.5,0.5"
                       TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="4"
                                      Direction="270"
                                      Opacity="0.72"
                                      ShadowDepth="1"
                                      Color="#D0000000" />
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PreviousLyricScaleTransform" />
                        <TranslateTransform x:Name="PreviousLyricTranslateTransform" />
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>
            <ScrollViewer x:Name="CurrentLyricViewport"
                          Width="300"
                          HorizontalAlignment="Center"
                          HorizontalContentAlignment="Left"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          ClipToBounds="True"
                          Focusable="False">
                <Grid x:Name="CurrentLyricRow"
                      Margin="0,2"
                      HorizontalAlignment="Left"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CurrentLyricScaleTransform" />
                            <TranslateTransform x:Name="CurrentLyricTranslateTransform" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <TextBlock x:Name="CurrentLyricBaseText"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#78FFFFFF"
                               Text="正在连接网易云音乐…"
                               TextAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="5"
                                              Direction="270"
                                              Opacity="0.85"
                                              ShadowDepth="2"
                                              Color="#CC000000" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="CurrentLyricText"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="正在连接网易云音乐…"
                               TextAlignment="Center">
                        <TextBlock.Clip>
                            <RectangleGeometry x:Name="CurrentLyricClip" />
                        </TextBlock.Clip>
                    </TextBlock>
                </Grid>
            </ScrollViewer>
            <TextBlock x:Name="NextLyricText"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="14.4"
                       Foreground="White"
                       Opacity="0.58"
                       RenderTransformOrigin="0.5,0.5"
                       TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="4"
                                      Direction="270"
                                      Opacity="0.72"
                                      ShadowDepth="1"
                                      Color="#D0000000" />
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="NextLyricScaleTransform" />
                        <TranslateTransform x:Name="NextLyricTranslateTransform" />
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>
            </StackPanel>
        </Grid>
        </ScrollViewer>
        <Grid x:Name="WidthIndicatorPanel"
              Grid.Row="1"
              Height="8"
              Margin="0,0,0,4"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="WidthIndicatorTranslateTransform" />
            </Grid.RenderTransform>
            <Grid x:Name="WidthIndicatorTrack"
                  Height="3"
                  VerticalAlignment="Center"
                  Background="#FF42A5F5" />
        </Grid>
        <Popup x:Name="PlaybackControlsPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=RootGrid}"
               AllowsTransparency="True"
               StaysOpen="True"
               Focusable="False"
               PopupAnimation="None">
            <Grid x:Name="PlaybackControlsPopupSurface"
                  Width="{Binding ActualWidth, ElementName=RootGrid}"
                  Height="42"
                  Background="Transparent"
                  MouseEnter="PlaybackControlsPopupSurface_MouseEnter"
                  MouseLeave="PlaybackControlsPopupSurface_MouseLeave">
                <Border x:Name="PlaybackControlsPanel"
                        Width="{Binding ActualWidth, ElementName=LyricsViewport}"
                        MaxWidth="140"
                        Height="36"
                        Padding="4,3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="#FF242630"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="18"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PlaybackControlsTranslateTransform" Y="6" />
                    </Border.RenderTransform>
                    <UniformGrid Columns="3">
                        <Button Content="&#xE892;"
                                ToolTip="上一首"
                                Style="{StaticResource PlaybackControlButton}"
                                Click="PreviousTrackButton_Click" />
                        <Button x:Name="PlayPauseOverlayButton"
                                Content="&#xE769;"
                                ToolTip="暂停"
                                Style="{StaticResource PlaybackControlButton}"
                                Click="PlayPauseButton_Click" />
                        <Button Content="&#xE893;"
                                ToolTip="下一首"
                                Style="{StaticResource PlaybackControlButton}"
                                Click="NextTrackButton_Click" />
                    </UniformGrid>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</Window>
